{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-job.v1.json",
  "title": "Cornerstone Agent Job",
  "type": "object",
  "required": ["schema_version", "job_id", "type", "created_at", "params"],
  "properties": {
    "schema_version": { "const": "agent-job.v1" },
    "job_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "get_status",
        "get_sets",
        "get_set_reps",
        "collect",
        "rules_eval",
        "log_tail",
        "ui_inspect"
      ]
    },
    "created_at": { "type": "string" },
    "timeout_s": { "type": "integer", "minimum": 5, "maximum": 300 },
    "reply_to": { "type": "string" },
    "trace_id": { "type": "string" },
    "params": { "type": "object" }
  },
  "additionalProperties": false
}
